      m_Calls: []
  m_text: "You wake up in a strange cabin, alone and unsure of how you got here.
    An uneasy feeling settles in you as you look around, you must escape; a cauldron
    is in front of you. Maybe you can use it to escape. There's a hole in the wall
    but you\u2019re way too big to fit. Maybe you can shrink down. Start by heating
    up the cauldron. There must be something to start a fire around here somewhere?"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7985844431d3a1d409c52c138519b886, type: 2}
  m_sharedMaterial: {fileID: 5600211707311277031, guid: 7985844431d3a1d409c52c138519b886, type: 2}
